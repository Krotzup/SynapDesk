# URL base del backend FastAPI
# Desarrollo local: http://localhost:8000
# Staging: URL asignada por Render al desplegar el backend
# Las solicitudes se envían a: NEXT_PUBLIC_API_URL/api/v1
# El puerto 3000 corresponde al frontend Next.js y no debe usarse como URL del backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Solo servidor Next.js. La búsqueda del navegador usa /api/v1/search del mismo origen.
BACKEND_INTERNAL_URL=http://localhost:8000
SEARCH_PUBLIC_ORIGIN=http://localhost:3000
# Usar el perfil local o production acordado con FastAPI y el proxy general.
# AUTH_COOKIE_PROFILE=local
# Alternativa para ensayos sin perfil. Ambos procesos deben usar el mismo nombre.
# SEARCH_SESSION_COOKIE_NAME=CONFIGURAR_NOMBRE_DE_COOKIE
# Habilitar solo para HTTP de loopback local; HTTPS se exige para otros destinos.
BACKEND_ALLOW_HTTP_LOCAL=false

# Datos de ejemplo (frontend/src/mocks) mientras el backend no expone las rutas.
# true: los services devuelven datos de ejemplo; false u omitida: llaman al backend.
NEXT_PUBLIC_USE_MOCKS=true
