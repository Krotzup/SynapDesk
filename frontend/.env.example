# ─── Canal de servidor hacia FastAPI (proxy /api/v1/* y lecturas SSR) ───
# Todas son solo de servidor: NUNCA usar el prefijo NEXT_PUBLIC_. Si falta alguna o no es válida,
# el proxy y el SSR responden 503 sin contactar al backend. Solo hacen falta con
# NEXT_PUBLIC_USE_MOCKS=false.

# Destino FastAPI. Exactamente el origen https:// (esquema, host y puerto), sin usuario, ruta,
# query ni "#". SEC-01B exige TLS directo también en local: http:// se rechaza.
# El certificado del backend debe ser válido para ese host (CA y nombre verificados por Node).
# Para una CA local de prueba, agregarla solo al proceso de Next con la variable estándar de Node
# NODE_EXTRA_CA_CERTS=/ruta/a/ca.crt; nunca desactivar la verificación de certificados.
BACKEND_INTERNAL_URL=https://127.0.0.1:8000

# Credencial de servicio SEC-01B: 32 bytes aleatorios en base64url sin relleno (43 caracteres),
# distinta por entorno. FastAPI guarda solo su digest (AUTH_INTERMEDIARIO). Nombre provisional
# (decisión C07 pendiente). No tiene valor por omisión; generarla, por ejemplo, con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# BACKEND_SERVICE_CREDENTIAL=

# Perfil de cookies, obligatorio: local (synapdesk_*_dev) o production (__Host-synapdesk_*).
# Sin valor por omisión: ausente, vacío u otro valor es un error de configuración (503).
# Nombres propuestos en el contrato de autenticación (C02).
AUTH_COOKIE_PROFILE=local

# La búsqueda usa el mismo canal de servidor y requiere además el Origin público exacto.
SEARCH_PUBLIC_ORIGIN=http://localhost:3000
# Opcional. Si se declara, debe coincidir con la cookie de sesión del perfil.
# SEARCH_SESSION_COOKIE_NAME=CONFIGURAR_NOMBRE_DE_COOKIE

# Datos de ejemplo (frontend/src/mocks) mientras el backend no expone las rutas.
# true: los services devuelven datos de ejemplo; false u omitida: llaman al backend.
NEXT_PUBLIC_USE_MOCKS=true
