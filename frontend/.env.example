# Destino FastAPI del proxy de mismo origen. Solo de servidor: NO usar el prefijo NEXT_PUBLIC_.
# El navegador pide /api/v1/* a Next.js (http://localhost:3000) y Next.js reenvía a esta URL,
# conservando /api/v1. Las páginas del servidor también la usan para leer datos (SSR).
# Local: FastAPI escucha solo en 127.0.0.1:8000. Indicar solo esquema, host y puerto.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Cookies de sesión y de contexto CSRF que el proxy reenvía: local (synapdesk_*_dev) o
# production (__Host-synapdesk_*). Omitida: local. Otro valor (también vacío): error de configuración,
# el proxy responde 503. Nombres propuestos en el contrato de autenticación.
AUTH_COOKIE_PROFILE=local

# Datos de ejemplo (frontend/src/mocks) mientras el backend no expone las rutas.
# true: los services devuelven datos de ejemplo; false u omitida: llaman al backend.
NEXT_PUBLIC_USE_MOCKS=true
