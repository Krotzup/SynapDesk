# Entorno general
APP_ENV=development

# PostgreSQL local
POSTGRES_DB=synapdesk
POSTGRES_USER=synapdesk_app
POSTGRES_PASSWORD=reemplazar_con_clave_local
POSTGRES_PORT=5432

# PostgreSQL para pruebas automatizadas
POSTGRES_TEST_DB=synapdesk_test
POSTGRES_TEST_USER=synapdesk_test
POSTGRES_TEST_PASSWORD=reemplazar_con_clave_testing_local
POSTGRES_TEST_PORT=5433

# ─── Frontend (frontend/.env.local) ──────────────────────────────────────────
# URL base del backend FastAPI
# Desarrollo local: http://localhost:8000
# Staging: URL asignada por Render al desplegar el backend
NEXT_PUBLIC_API_URL=http://localhost:8000
