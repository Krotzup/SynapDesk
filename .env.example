# Entorno general
APP_ENV=development

# Backend: lista JSON de orígenes permitidos para el frontend local
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Seguridad AUTH-06: configuración provisional, sin calibración de producción.
# El backend básico y Alembic no requieren construir servicios de autenticación.
# Antes de usar autenticación, completar y descomentar el par HMAC y las seis cuotas.
# Sus marcadores son inválidos a propósito; no son valores operativos.
AUTH_ARGON2_MEMORIA_KIB=65536
AUTH_ARGON2_ITERACIONES=3
AUTH_ARGON2_PARALELISMO=1

# Generar una clave privada local con 32 bytes CSPRNG, en base64 canónico:
# python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode('ascii'))"
# Mantener la salida privada; no copiarla a logs, commits ni NEXT_PUBLIC_*.
# AUTH_HMAC_CLAVE=REEMPLAZAR_POR_BASE64_DE_32_BYTES_ALEATORIOS
# AUTH_HMAC_ID_CLAVE=local-v1

# Listas JSON, independientes de CORS. No hay confianza automática en localhost.
AUTH_ORIGENES_PERMITIDOS=["http://localhost:3000"]
# Ningún proxy autorizado hasta acreditar la procedencia del transporte.
AUTH_PROXIES_AUTORIZADOS=[]

# Contextos/tokens CSRF: valores provisionales existentes, sin nueva expulsión.
AUTH_CSRF_TOKEN_BYTES=32
AUTH_CSRF_TOKEN_SEGUNDOS=600
AUTH_CSRF_CONTEXTO_SEGUNDOS=900
AUTH_CSRF_MAX_TOKENS=8
# Sesiones: 8 horas absolutas y 30 minutos de inactividad son constantes
# aprobadas del servicio; no existen variables de duración configurables.

# Elegir explícitamente seis enteros positivos para las pruebas locales.
# No hay cuotas, ventanas ni bloqueos definitivos aprobados para producción.
# AUTH_LIMITE_CUENTA_INTENTOS=CONFIGURAR_ENTERO_POSITIVO
# AUTH_LIMITE_CUENTA_VENTANA_SEGUNDOS=CONFIGURAR_ENTERO_POSITIVO
# AUTH_LIMITE_CUENTA_BLOQUEO_SEGUNDOS=CONFIGURAR_ENTERO_POSITIVO
# AUTH_LIMITE_IP_INTENTOS=CONFIGURAR_ENTERO_POSITIVO
# AUTH_LIMITE_IP_VENTANA_SEGUNDOS=CONFIGURAR_ENTERO_POSITIVO
# AUTH_LIMITE_IP_BLOQUEO_SEGUNDOS=CONFIGURAR_ENTERO_POSITIVO
AUTH_LIMITE_REINTENTOS_VERSION=2

# PostgreSQL local
POSTGRES_DB=synapdesk
POSTGRES_USER=synapdesk_app
POSTGRES_PASSWORD=reemplazar_con_clave_local
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_SSLMODE=prefer
POSTGRES_TEST_HOST=127.0.0.1

# Prototipo local de búsqueda semántica (no se carga automáticamente en PowerShell)
SYNAPDESK_SEMANTIC_DATABASE_URL=postgresql://synapdesk_test:reemplazar_con_clave_testing_local@localhost:5433/synapdesk_semantic_test

# Dejar vacía salvo al activar las pruebas reales contra la base semántica propia.
# No apuntar ninguna conexión semántica a synapdesk_test (reservada al backend).
SYNAPDESK_SEMANTIC_TEST_DATABASE_URL=

# PostgreSQL para pruebas automatizadas
POSTGRES_TEST_DB=synapdesk_test
POSTGRES_TEST_USER=synapdesk_test
POSTGRES_TEST_PASSWORD=reemplazar_con_clave_testing_local
POSTGRES_TEST_PORT=5433

# ─── Frontend (frontend/.env.local) ──────────────────────────────────────────
# URL base del backend FastAPI
# Desarrollo local: http://localhost:8000
# Staging: URL asignada por Render al desplegar el backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Datos de ejemplo (frontend/src/mocks) mientras el backend no expone las rutas.
# true: los services devuelven datos de ejemplo; false u omitida: llaman al backend.
NEXT_PUBLIC_USE_MOCKS=true
